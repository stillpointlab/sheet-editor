{
  "name": "@stillpointlab/sheet-editor",
  "version": "0.1.0",
  "description": "Sheet document codecs and spreadsheet-style grid web components.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./src/index.ts",
    "./src/editor/index.ts",
    "./src/editor/sheet-editor.ts",
    "./src/grid/index.ts",
    "./src/grid/sheet-grid.ts",
    "./src/preview/index.ts",
    "./src/preview/sheet-preview.ts",
    "./dist/index.js",
    "./dist/index.cjs",
    "./dist/editor.js",
    "./dist/editor.cjs",
    "./dist/grid.js",
    "./dist/grid.cjs",
    "./dist/preview.js",
    "./dist/preview.cjs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./csv": {
      "types": "./dist/csv.d.ts",
      "import": "./dist/csv.js",
      "require": "./dist/csv.cjs"
    },
    "./grid": {
      "types": "./dist/grid.d.ts",
      "import": "./dist/grid.js",
      "require": "./dist/grid.cjs"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "import": "./dist/preview.js",
      "require": "./dist/preview.cjs"
    },
    "./presentation": {
      "types": "./dist/presentation.d.ts",
      "import": "./dist/presentation.js",
      "require": "./dist/presentation.cjs"
    },
    "./document": {
      "types": "./dist/document.d.ts",
      "import": "./dist/document.js",
      "require": "./dist/document.cjs"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "import": "./dist/editor.js",
      "require": "./dist/editor.cjs"
    },
    "./interaction": {
      "types": "./dist/interaction.d.ts",
      "import": "./dist/interaction.js",
      "require": "./dist/interaction.cjs"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "csv.d.ts",
    "grid.d.ts",
    "preview.d.ts",
    "presentation.d.ts",
    "document.d.ts",
    "editor.d.ts",
    "interaction.d.ts"
  ],
  "scripts": {
    "gen:styles": "node scripts/gen-styles.mjs",
    "prepare": "npm run build",
    "build": "npm run gen:styles && tsup",
    "dev": "npm run gen:styles && vite",
    "typecheck": "npm run gen:styles && tsc --noEmit",
    "test": "npm run gen:styles && vitest run",
    "lint": "eslint .",
    "format": "prettier --check \"**/*.{ts,mjs,json,md,scss,css,html}\"",
    "format:fix": "prettier --write \"**/*.{ts,mjs,json,md,scss,css,html}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-import-x": "^4.17.0",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.5.3",
    "sass": "^1.86.3",
    "tsup": "^8.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
